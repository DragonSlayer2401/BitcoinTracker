# Optional: remote database for hosted/serverless deployments.
# Local runs default to data/bitcoin-research.db without a paid subscription.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=

# Required to protect research endpoints when accessed beyond localhost.
# Sign in through /api/research/status using the browser's authentication prompt.
# RESEARCH_API_USERNAME=
# RESEARCH_API_PASSWORD=

# Optional official BRTI feed. Public Kalshi targets/schedules/results need no API key.
# Benchmark access requires a Kalshi account entitlement; no price is published in its API docs.
# Keep both values server-only. Never prefix them with NEXT_PUBLIC_.
# Use the production Key ID, not the descriptive name assigned to the key.
# A quoted multiline private key also works: paste the entire downloaded file between quotes.
# After saving .env.local, run pnpm kalshi:check and restart the app/collector.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
